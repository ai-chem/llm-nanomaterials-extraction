# VLM Configuration
# Gemma3-27b server
GEMMA_API_URL=http://your-server-ip:port/v1
GEMMA_API_KEY=your-api-key-here

# GLM 4.1 server (optional)
GLM_PORT=port-number
GLM_API_URL=http://your-server-ip:port/v1
GLM_API_KEY=your-api-key-here

# YOLO Model Path
YOLO_PATH=/path/to/your/yolo/model.pt

# OpenAI Configuration (optional fallback)
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1